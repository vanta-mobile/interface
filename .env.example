# Public application configuration only. Copy to .env and fill in the IDs.
# Do not add signing passwords, certificates, private keys, or API secrets.
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
REOWN_PROJECT_ID=
WALLET_LOGIN_ORIGIN=https://app.vanta.exchange
# Optional Vanta API origin (HTTPS, no path). Empty disables portfolio statistics.
VANTA_API_ORIGIN=
# Optional public DSN. Empty disables monitoring; never add SENTRY_AUTH_TOKEN.
SENTRY_DSN=
# Required with a DSN: development, staging, or production.
SENTRY_ENVIRONMENT=development
# Optional explicit release/distribution; otherwise the SDK uses app metadata.
SENTRY_RELEASE=
SENTRY_DIST=
